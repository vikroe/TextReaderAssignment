<UserControl x:Class="BigTextReader.App.View.UserControls.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BigTextReader.App.View.UserControls"
             xmlns:view="clr-namespace:BigTextReader.App.View"
             mc:Ignorable="d" 
             PreviewKeyDown="OnPreviewKeyDown"
             d:DesignWidth="800">
    <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PatternInput" Grid.Column="0" MinWidth="200" FontSize="16"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{x:Static view:Commands.Search}" />
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Grid.Column="1" Text="{Binding SearchStatus}" MinWidth="120"
                       TextAlignment="Right" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0" />

            <Button Grid.Column="2" Content="Search" Focusable="False" FontSize="16" Padding="10,2" Margin="6,0,0,0"
                    Command="{x:Static view:Commands.Search}" />

            <Button Grid.Column="3" Content="Previous" Focusable="False" FontSize="16" Padding="10,2" Margin="6,0,0,0"
                    Command="{x:Static view:Commands.FindPrevious}" />

            <Button Grid.Column="4" Content="Next" Focusable="False" FontSize="16" Padding="10,2" Margin="6,0,0,0"
                    Command="{x:Static view:Commands.FindNext}" />

            <Button Grid.Column="5" Content="Close" Focusable="False" FontSize="16" Padding="10,2" Margin="6,0,0,0"
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</UserControl>
