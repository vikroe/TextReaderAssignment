<UserControl x:Class="BigTextReader.App.View.UserControls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BigTextReader.App.View.UserControls"
             xmlns:view="clr-namespace:BigTextReader.App.View"
             mc:Ignorable="d" 
             Height="24" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="File" FontSize="16">
                <MenuItem Header="Open File..." FontSize="16" Command="ApplicationCommands.Open" />
                <MenuItem Header="Open URL..." FontSize="16" Command="{x:Static view:Commands.OpenUrl}" />
                <MenuItem Header="Generate Text..." FontSize="16" Command="{x:Static view:Commands.GenerateRandomText}" />
                <Separator />
                <MenuItem Header="Save File..." FontSize="16" Command="ApplicationCommands.Save" />
            </MenuItem>
            <MenuItem Header="View" FontSize="16">
                <MenuItem Header="Find" FontSize="16" Command="ApplicationCommands.Find" />
            </MenuItem>
        </Menu>

    </Grid>
</UserControl>
