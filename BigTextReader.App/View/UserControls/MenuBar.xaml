<UserControl x:Class="BigTextReader.App.View.UserControls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BigTextReader.App.View.UserControls"
             mc:Ignorable="d" 
             Height="24" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="File" FontSize="16">
                <MenuItem Header="Synthetic Source" FontSize="16" Command="{Binding SelectSynthSourceCommand}"/>
            </MenuItem>
        </Menu>

    </Grid>
</UserControl>
