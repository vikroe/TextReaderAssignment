<Window x:Class="BigTextReader.App.View.Dialogs.RandomTextPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BigTextReader.App.View.Dialogs"
        mc:Ignorable="d"
        Title="Generate Random Text" Height="175" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Loaded="OnLoaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Number of lines" Margin="0,0,0,4" />
        <TextBox x:Name="LineCountBox" Grid.Row="1" Height="26" VerticalContentAlignment="Center"
                 FontFamily="Consolas" TextChanged="OnLineCountChanged" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox x:Name="LineNumberCheckBox" VerticalAlignment="Center" />
            <TextBlock Text="Add line number" Margin="4,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,4,0,0"
                   Foreground="#C62828" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="GenerateButton" Content="Generate" IsDefault="True" IsEnabled="False"
                    Width="84" Margin="0,0,8,0" Click="OnGenerate" />
            <Button Content="Cancel" IsCancel="True" Width="84" />
        </StackPanel>
    </Grid>
</Window>
